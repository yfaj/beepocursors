{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beepo Cursors",
  "version": "1.2.0",
  "identifier": "com.yfaj.beepo-cursors",
  "build": {
      "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
      "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beepo Cursors",
        "width": 800,
        "height": 560,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["beepocursors"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "yfaj",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
